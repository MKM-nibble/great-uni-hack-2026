# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-opus-5-5).
# claude-haiku-5-5 is about 40x cheaper per token if credits run low.
STAGGER_MODEL=
# Optional: max live Claude calls per server process (default 150).
STAGGER_MAX_CALLS=
