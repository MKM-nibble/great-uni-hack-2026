# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-opus-5-5).
# claude-haiku-5-5 is about 40x cheaper per token if credits run low.
STAGGER_MODEL=
# Optional: max live Claude calls per server process (default 150).
STAGGER_MAX_CALLS=

# Neon: filled in by `neon link` / `neon env pull` (see README).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Protects /api/ingest/* (Vercel Cron sends it automatically) and /admin.
CRON_SECRET=
ADMIN_TOKEN=
# true = news signals go live without review (demo only).
AUTO_PUBLISH_SIGNALS=
